{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tokens": "node scripts/build-tokens.mjs",
    "scanlines": "for f in cta-raw cta-labelled; do node scripts/scanline-svg.mjs scripts/illustration-src/$f.svg public/illustrations/$f.svg; done && node scripts/scanline-svg.mjs --wordmark scripts/illustration-src/wordmark-mask.png public/illustrations/wordmark.svg --pitch 6",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens"
  },
  "dependencies": {
    "lucide-react": "^1.72.0",
    "next": "15.5.29",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
