{
  "$description": "Abaka design tokens. Single source of truth. Primitives mirror the Paper file; semantic tokens are what components use. Build with `npm run tokens`.",
  "color": {
    "$type": "color",
    "canvas": {
      "$value": "#F9F9F9",
      "$description": "Page background. Light, like a spec sheet."
    },
    "raised": {
      "$value": "#FFFFFF",
      "$description": "Raised surfaces: hovered cells, dropdown panels."
    },
    "line": {
      "$value": "#EDEDED",
      "$description": "Every grid line and divider."
    },
    "ink": {
      "$value": "#141414",
      "$description": "The one text colour. Lighter text is this ink at opacity."
    },
    "ink-72": {
      "$value": "#141414B8"
    },
    "ink-56": {
      "$value": "#1414148F"
    },
    "ink-64": {
      "$value": "#141414A3",
      "$description": "Smallest text that still passes AA on canvas (5.45:1). Added in code; Paper still uses ink-56 for labels."
    },
    "ink-40": {
      "$value": "#14141466"
    },
    "ink-10": {
      "$value": "#1414141A"
    },
    "ink-pressed": {
      "$value": "#000000"
    },
    "accent": {
      "$value": "#FD5F32",
      "$description": "Orange. Marks actions and one emphasis per section."
    },
    "on-accent": {
      "$value": "#F4F4F4"
    },
    "accent-66": {
      "$value": "#FD5F3266"
    },
    "accent-29": {
      "$value": "#FD5F3229"
    },
    "accent-sheen": {
      "$value": "#FFFFFF29",
      "$description": "Primary hover: white sheen over the orange. The orange never changes."
    },
    "active-tint": {
      "$value": "#FD5F320A"
    },
    "grey-100": {
      "$value": "#F5F5F5"
    },
    "grey-200": {
      "$value": "#EDEDED"
    },
    "grey-300": {
      "$value": "#DBDBDB"
    },
    "grey-400": {
      "$value": "#CCCCCC"
    },
    "grey-500": {
      "$value": "#BDBDBD"
    },
    "grey-600": {
      "$value": "#A1A1A1"
    },
    "grey-700": {
      "$value": "#8F8F8F"
    },
    "text": {
      "primary": {
        "$value": "{color.ink}"
      },
      "secondary": {
        "$value": "{color.ink-72}"
      },
      "tertiary": {
        "$value": "{color.ink-64}",
        "$description": "Mono labels and captions. Was ink-56 (4.13:1, fails AA at 12px); raised to ink-64 (5.45:1)."
      },
      "muted": {
        "$value": "{color.ink-40}"
      },
      "accent": {
        "$value": "{color.accent}",
        "$description": "Known issue: 2.91:1 on canvas. Used only at display sizes."
      },
      "on-accent": {
        "$value": "{color.on-accent}",
        "$description": "Known issue: 2.78:1 on accent. Fix option: ink on accent (6.02:1)."
      },
      "inverse": {
        "$value": "{color.canvas}"
      }
    },
    "surface": {
      "page": {
        "$value": "{color.canvas}"
      },
      "raised": {
        "$value": "{color.raised}"
      },
      "inverse": {
        "$value": "{color.ink}"
      },
      "active": {
        "$value": "{color.active-tint}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.line}"
      },
      "strong": {
        "$value": "{color.ink}"
      },
      "hover": {
        "$value": "{color.grey-500}"
      }
    },
    "action": {
      "primary-bg": {
        "$value": "{color.accent}"
      },
      "primary-fg": {
        "$value": "{color.on-accent}"
      },
      "primary-sheen": {
        "$value": "{color.accent-sheen}"
      },
      "secondary-border": {
        "$value": "{color.ink}"
      },
      "secondary-hover-bg": {
        "$value": "{color.ink}"
      },
      "secondary-pressed-bg": {
        "$value": "{color.ink-pressed}"
      },
      "disabled-bg": {
        "$value": "{color.grey-200}"
      },
      "disabled-fg": {
        "$value": "{color.ink-40}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.ink}",
        "$description": "2px ring outside a 2px gap. :focus-visible only."
      },
      "gap": {
        "$value": "{color.canvas}"
      },
      "halo": {
        "$value": "{color.ink-10}",
        "$description": "Text field focus halo, 3px."
      }
    }
  },
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "var(--font-inter), Inter, system-ui, sans-serif"
    },
    "mono": {
      "$value": "var(--font-jetbrains), 'JetBrains Mono', ui-monospace, monospace"
    }
  },
  "text": {
    "$type": "dimension",
    "mono-sm": {
      "$value": "11px"
    },
    "label": {
      "$value": "12px"
    },
    "sm": {
      "$value": "14px"
    },
    "body": {
      "$value": "15px"
    },
    "lead": {
      "$value": "16px"
    },
    "hero-lead": {
      "$value": "19px"
    },
    "title": {
      "$value": "20px"
    },
    "h3": {
      "$value": "24px"
    },
    "display": {
      "$value": "56px"
    },
    "hero": {
      "$value": "66px"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "regular": {
      "$value": "400"
    },
    "medium": {
      "$value": "500"
    },
    "semibold": {
      "$value": "600"
    }
  },
  "leading": {
    "$type": "dimension",
    "label": {
      "$value": "16px"
    },
    "sm": {
      "$value": "20px"
    },
    "body": {
      "$value": "22px"
    },
    "lead": {
      "$value": "24px"
    },
    "title": {
      "$value": "26px"
    },
    "display": {
      "$value": "60px"
    },
    "hero": {
      "$value": "67px"
    }
  },
  "tracking": {
    "$type": "dimension",
    "display": {
      "$value": "-0.035em"
    },
    "tight": {
      "$value": "-0.02em"
    },
    "label": {
      "$value": "0.14em"
    }
  },
  "space": {
    "$type": "dimension",
    "1": {
      "$value": "8px"
    },
    "2": {
      "$value": "12px"
    },
    "3": {
      "$value": "16px"
    },
    "4": {
      "$value": "20px"
    },
    "5": {
      "$value": "24px"
    },
    "6": {
      "$value": "32px"
    },
    "7": {
      "$value": "40px"
    },
    "8": {
      "$value": "48px"
    },
    "9": {
      "$value": "96px"
    }
  },
  "radius": {
    "$type": "dimension",
    "none": {
      "$value": "0px",
      "$description": "Every control is square."
    },
    "window": {
      "$value": "12px",
      "$description": "Floating windows only: dropdown panels, product shots."
    }
  },
  "container": {
    "$type": "dimension",
    "column": {
      "$value": "1240px"
    },
    "page": {
      "$value": "1440px"
    }
  },
  "breakpoint": {
    "$type": "dimension",
    "$description": "In rem so Tailwind can order them with its own sm breakpoint. 48rem = 768px, 64rem = 1024px, 80rem = 1280px.",
    "sm": {
      "$value": "40rem"
    },
    "md": {
      "$value": "48rem"
    },
    "lg": {
      "$value": "64rem"
    },
    "xl": {
      "$value": "80rem"
    }
  },
  "duration": {
    "$type": "duration",
    "press": {
      "$value": "50ms",
      "$description": "Pressed: shrink to 99%."
    },
    "fast": {
      "$value": "120ms",
      "$description": "Hover colour and border changes."
    },
    "base": {
      "$value": "200ms",
      "$description": "Arrows, cell fills, chevrons."
    },
    "slow": {
      "$value": "320ms",
      "$description": "Dropdown panels, FAQ open."
    }
  },
  "ease": {
    "$type": "cubicBezier",
    "out": {
      "$value": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "icon": {
    "$type": "dimension",
    "stroke": {
      "$value": "1.5"
    },
    "sm": {
      "$value": "16px"
    },
    "md": {
      "$value": "22px"
    }
  }
}